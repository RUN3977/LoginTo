{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@loginto/vault-core": ["packages/vault-core/src/index.ts"],
      "@loginto/crypto-core": ["packages/crypto-core/src/index.ts"],
      "@loginto/sync-core": ["packages/sync-core/src/index.ts"],
      "@loginto/ocr-core": ["packages/ocr-core/src/index.ts"],
      "@loginto/ui": ["packages/ui/src/index.ts"]
    }
  }
}
